{
  "manifest_version": 3,
  "name": "红薯收纳 · 小红书、抖音、X 与花瓣素材下载",
  "version": "1.8.1",
  "description": "原格式批量并行下载；单张失败自动跳过并继续后续图片，支持仅重试未完成。",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.xiaohongshu.com/*",
    "https://*.xhscdn.com/*",
    "https://*.douyin.com/*",
    "https://*.douyinvod.com/*",
    "https://*.douyinpic.com/*",
    "https://*.byteimg.com/*",
    "https://*.ibytedtos.com/*",
    "https://*.bytedance.com/*",
    "https://*.bytecdn.cn/*",
    "https://*.pstatp.com/*",
    "https://*.snssdk.com/*",
    "https://*.iesdouyin.com/*",
    "https://x.com/*",
    "https://www.x.com/*",
    "https://twitter.com/*",
    "https://www.twitter.com/*",
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*",
    "https://huaban.com/*",
    "https://*.huaban.com/*",
    "https://*.huabanimg.com/*",
    "https://*.hb.aicdn.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "下载当前帖子素材（X 首页请点击帖子内按钮）"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.douyin.com/*"
      ],
      "js": [
        "douyin-capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://www.douyin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "x-capture.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "x-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://huaban.com/*",
        "https://www.huaban.com/*"
      ],
      "js": [
        "huaban-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
