{
  "manifest_version": 3,
  "name": "红薯收纳 · 本帖素材下载",
  "version": "1.3.1",
  "description": "一键收纳当前小红书笔记的图片、视频和 Live，按作者、发布时间和文案归档。",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://*.xiaohongshu.com/*",
    "https://*.xhscdn.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "下载当前小红书帖子的全部素材"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
